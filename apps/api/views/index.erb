<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>FirdausCipher — GUI Mini (Ruby)</title>
  <style>
    :root { --bg:#0f172a; --card:#1e293b; --ink:#e2e8f0; --mut:#94a3b8; --acc:#38bdf8; --ok:#4ade80; --err:#f87171; }
    * { box-sizing: border-box; }
    body { margin:0; padding:2rem 1rem; background:var(--bg); color:var(--ink);
           font:15px/1.55 ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif; }
    .wrap { max-width: 860px; margin: 0 auto; }
    h1 { margin:0 0 .25rem; font-size:1.6rem; }
    .card { background:var(--card); border:1px solid #334155; border-radius:12px; padding:1.25rem; margin-bottom:1rem; }
    label { display:block; font-weight:600; font-size:.86rem; margin:.75rem 0 .3rem; }
    .hint { color:var(--mut); font-weight:400; }
    input[type=text], input[type=number], select, textarea {
      width:100%; padding:.55rem .7rem; border-radius:8px; border:1px solid #475569;
      background:#0b1220; color:var(--ink); font-family:ui-monospace, SFMono-Regular, Menlo, monospace; font-size:.9rem; }
    textarea { min-height:90px; resize:vertical; }
    input[type=file] { width:100%; padding:.5rem; border-radius:8px; border:1px dashed #475569;
      background:#0b1220; color:var(--mut); font-size:.85rem; }
    h2 { font-size:1.05rem; margin:0 0 .35rem; }
    .alert { border-radius:8px; padding:.6rem .75rem; font-size:.83rem; margin:.6rem 0 0;
             border:1px solid; line-height:1.5; }
    .alert.danger { border-color:#7f1d1d; background:rgba(248,113,113,.12); color:#fca5a5; }
    .alert.danger strong { color:#f87171; }
    .alert.ok { border-color:#14532d; background:rgba(74,222,128,.10); color:#86efac; }
    .alert.ok strong { color:#4ade80; }
    .row { display:flex; gap:.6rem; flex-wrap:wrap; align-items:center; margin-top:1rem; }
    button { padding:.6rem 1.1rem; border-radius:8px; border:0; background:var(--acc);
             color:#062033; font-weight:700; cursor:pointer; font-size:.9rem; }
    button.sec { background:#334155; color:var(--ink); }
    .size-row { display:flex; gap:.4rem; align-items:center; flex-wrap:wrap; margin-top:.35rem; }
    .size-row button { padding:.3rem .65rem; font-size:.8rem; background:#334155; color:var(--ink); }
    .size-row button.active { background:var(--acc); color:#062033; }
    .matrix-grid { display:grid; gap:.5rem; margin:.5rem 0; justify-content:start; }
    .matrix-grid input { width:100%; text-align:center; padding:.5rem .3rem;
      font-family:ui-monospace, SFMono-Regular, Menlo, monospace; }
    .badge { display:inline-block; padding:.15rem .5rem; border-radius:999px; background:#334155;
             color:var(--mut); font-size:.75rem; margin-left:.4rem; }
    pre { background:#0b1220; border:1px solid #334155; border-radius:8px; padding:.85rem;
          overflow-x:auto; font-size:.84rem; white-space:pre-wrap; word-break:break-all; margin:.35rem 0 0; }
    .ok { color:var(--ok); } .err { color:var(--err); }
    .grid2 { display:grid; grid-template-columns:1fr 1fr; gap:1rem; }
    @media (max-width:640px){ .grid2{ grid-template-columns:1fr; } }
    .kv { color:var(--mut); font-size:.82rem; margin-top:.5rem; }
  </style>
</head>
<body>
<div class="wrap">
  <h1>FirdausCipher <span class="badge">GUI mini · Ruby</span></h1>

  <% if error %>
    <div class="card"><strong class="err">Error:</strong> <%= error %></div>
  <% end %>

  <form class="card" method="post" action="/gui" id="form">
    <label for="cipher">Cipher</label>
    <select name="cipher" id="cipher">
      <% ciphers.each do |c| %>
        <option value="<%= c['slug'] %>" data-mode="<%= c['mode'] %>" data-fields='<%= c['keyFields'].to_json %>'
                <%= 'selected' if form['cipher'] == c['slug'] %>>
          <%= c['label'] %>
        </option>
      <% end %>
    </select>

    <div id="fields"></div>

    <label for="direction">Arah</label>
    <select name="direction" id="direction">
      <option value="encrypt" <%= 'selected' if form['direction'] == 'encrypt' %>>Enkripsi</option>
      <option value="decrypt" <%= 'selected' if form['direction'] == 'decrypt' %>>Dekripsi</option>
    </select>

    <label for="input">Input <span class="hint">— teks biasa (bukan base64)</span></label>
    <textarea name="input_text" id="input" placeholder="Serang subuh"><%= form['input_text'] %></textarea>

    <div class="row">
      <button type="submit">Proses</button>
      <button type="button" class="sec" id="swap">Tukar input ⇄ output</button>
    </div>
  </form>

  <div class="card">
    <h2>Enkripsi / Dekripsi File</h2>
    <p class="kv">File apa pun (gambar, audio, video, database) diproses di server Ruby
       dan diunduh otomatis. Gunakan cipher biner (c/g) agar file utuh saat didekripsi.</p>

    <label for="file-cipher">Cipher <span class="hint">— dipakai saat enkripsi; saat dekripsi dibaca dari file .dat</span></label>
    <select id="file-cipher">
      <% ciphers.each do |c| %>
        <option value="<%= c['slug'] %>" data-fields='<%= c['keyFields'].to_json %>'>
          <%= c['label'] %>
        </option>
      <% end %>
    </select>

    <div id="file-warn"></div>

    <div id="file-fields"></div>

    <label for="file-direction">Arah</label>
    <select id="file-direction">
      <option value="encrypt">Enkripsi (file → .dat)</option>
      <option value="decrypt">Dekripsi (.dat → file asli)</option>
    </select>

    <label for="file-input">Pilih file</label>
    <input type="file" id="file-input" />

    <div class="row">
      <button type="button" id="file-go">Proses File</button>
    </div>

    <div id="file-status" class="kv"></div>
  </div>

  <% if result %>
    <div class="card">
      <strong class="ok">Hasil (<%= result[:meta][:direction] == 'encrypt' ? 'ciphertext' : 'plaintext' %>)</strong>
      <pre id="output"><%= result[:meta][:outputText] || '(biner — lihat base64 di bawah)' %></pre>
      <div class="kv">
        cipher: <%= result[:meta][:cipher] %> · mode: <%= result[:meta][:mode] %> ·
        <%= result[:meta][:inputBytes] %> → <%= result[:meta][:outputBytes] %> byte
      </div>
      <label>Base64 (siap kirim ke <code>/api/encrypt</code>)</label>
      <pre><%= result[:output] %></pre>
    </div>
  <% end %>

  <div class="card">
    <strong>REST API</strong>
    <div class="kv">Coba lewat curl:</div>
    <pre>curl -s http://127.0.0.1:9292/api/ciphers

curl -s -X POST http://127.0.0.1:9292/api/encrypt \
  -H 'Content-Type: application/json' \
  -d '{"cipher":"vigenere","mode":"text","input":"<%= (result ? result[:output] : 'QVRUQUNLQVREQVdO') %>","params":{"key":"LEMON"}}'</pre>
  </div>
</div>

<script>
  const defs = <%= ciphers.to_json %>;
  const sel = document.getElementById('cipher');
  const fields = document.getElementById('fields');
  const saved = <%= (form['params'] || {}).to_json %>;

  // ---- Helper matriks (Hill): "6,24,1;13,16,10" <-> grid ----
  function parseGrid(value) {
    return String(value).split(/[;\n]+/).map(r => r.trim()).filter(r => r.length)
      .map(row => row.split(',').map(t => t.trim()));
  }
  function serializeGrid(grid) {
    return grid.map(row => row.join(',')).join(';');
  }
  function resizeGrid(grid, n) {
    const out = [];
    for (let r = 0; r < n; r++) {
      const row = [];
      for (let c = 0; c < n; c++) row.push((grid[r] && grid[r][c] !== undefined) ? grid[r][c] : '0');
      out.push(row);
    }
    return out;
  }

  // Bangun HTML field matriks: tombol ukuran + grid sel. `scope` mencegah id bentrok,
  // `namePrefix` menyesuaikan cara form mengirim nilai ("params." utk form teks, "" utk file).
  // Nilai dikirim lewat SATU hidden input, sel hanya tampilan.
  function matrixHtml(f, val, scope, namePrefix) {
    const sizes = (f.sizes && f.sizes.length) ? f.sizes : [2, 3];
    const parsed = parseGrid(val);
    const size = sizes.indexOf(parsed.length) >= 0 ? parsed.length : sizes[0];
    const grid = resizeGrid(parsed, size);
    const serialized = serializeGrid(grid);

    const buttons = sizes.map(n =>
      `<button type="button" class="size-btn ${n === size ? 'active' : ''}"
        data-size="${n}" data-scope="${scope}" data-name="${f.name}"
        data-grid="${encodeURIComponent(serialized)}">${n}x${n}</button>`).join('');

    const cells = grid.map((row, r) => row.map((cell, c) =>
      `<input type="text" inputmode="numeric" class="cell"
        data-scope="${scope}" data-name="${f.name}"
        data-r="${r}" data-c="${c}" value="${cell}" aria-label="${f.label} baris ${r + 1} kolom ${c + 1}">`
    ).join('')).join('');

    const help = f.help ? `<p class="kv">${f.help}</p>` : '';
    return `<label>${f.label}</label>
      <div class="size-row">${buttons}</div>
      <div class="matrix-grid" data-scope="${scope}" data-name="${f.name}"
        style="grid-template-columns:repeat(${size}, 4rem)">${cells}</div>
      <input type="hidden" class="matrix-value" data-scope="${scope}" data-name="${f.name}"
        name="${namePrefix}${f.name}" value="${serialized}">
      ${help}`;
  }

  // Sinkronkan grid -> hidden input + simpan ke tombol ukuran.
  function syncMatrix(scope, name) {
    const gridEl = document.querySelector(`.matrix-grid[data-scope="${scope}"][data-name="${name}"]`);
    if (!gridEl) return '';
    const n = Number((gridEl.style.gridTemplateColumns.match(/repeat\((\d+)/) || [])[1] || 0);
    const grid = Array.from({ length: n }, () => Array.from({ length: n }, () => '0'));
    gridEl.querySelectorAll('input.cell').forEach(el => {
      grid[Number(el.dataset.r)][Number(el.dataset.c)] = el.value;
    });
    const serialized = serializeGrid(grid);
    const hidden = document.querySelector(`input.matrix-value[data-scope="${scope}"][data-name="${name}"]`);
    if (hidden) hidden.value = serialized;
    document.querySelectorAll(`.size-btn[data-scope="${scope}"][data-name="${name}"]`)
      .forEach(b => { b.dataset.grid = encodeURIComponent(serialized); });
    return serialized;
  }

  // Event delegation untuk tombol ukuran & sel matriks (berlaku utk TEKS & FILE).
  document.addEventListener('click', (e) => {
    const btn = e.target.closest && e.target.closest('.size-btn');
    if (!btn) return;
    const scope = btn.dataset.scope, name = btn.dataset.name;
    syncMatrix(scope, name);
    const current = decodeURIComponent(btn.dataset.grid || '');
    const gridEl = document.querySelector(`.matrix-grid[data-scope="${scope}"][data-name="${name}"]`);
    const n = Number(btn.dataset.size);
    // Pakai default valid per ukuran kalau ada (sizeDefaults), supaya matriks
    // langsung bisa dipakai, bukan potongan default ukuran lain yang singular.
    const def = defs.find(d => d.slug === sel.value);
    const field = def && (def.keyFields || []).find(f => f.name === name);
    const preset = field && field.sizeDefaults && field.sizeDefaults[String(n)];
    const grid = preset ? parseGrid(preset) : resizeGrid(parseGrid(current), n);
    gridEl.style.gridTemplateColumns = `repeat(${n}, 4rem)`;
    gridEl.innerHTML = grid.map((row, r) => row.map((cell, c) =>
      `<input type="text" inputmode="numeric" class="cell"
        data-scope="${scope}" data-name="${name}"
        data-r="${r}" data-c="${c}" value="${cell}" aria-label="Matriks baris ${r + 1} kolom ${c + 1}">`
    ).join('')).join('');
    document.querySelectorAll(`.size-btn[data-scope="${scope}"][data-name="${name}"]`)
      .forEach(b => b.classList.toggle('active', Number(b.dataset.size) === n));
    syncMatrix(scope, name);
  });

  document.addEventListener('input', (e) => {
    const cell = e.target.closest && e.target.closest('input.cell');
    if (cell) syncMatrix(cell.dataset.scope, cell.dataset.name);
  });

  function render() {
    const def = defs.find(d => d.slug === sel.value);
    fields.innerHTML = '';
    (def.keyFields || []).forEach(f => {
      const wrap = document.createElement('div');
      const val = saved[f.name] !== undefined ? saved[f.name] : (f.defaultValue ?? '');
      if (f.type === 'matrix') {
        wrap.innerHTML = matrixHtml(f, val, 'text', 'params.');
      } else {
        let inner;
        if (f.type === 'select') {
          const opts = (f.options || [
            {value:'A',label:'A'},{value:'B',label:'B'},{value:'C',label:'C'}
          ]).map(o => `<option value="${o.value}" ${o.value==val?'selected':''}>${o.label}</option>`).join('');
          inner = `<select name="params.${f.name}">${opts}</select>`;
        } else {
          inner = `<input type="${f.type === 'number' ? 'number' : 'text'}" name="params.${f.name}"
                    value="${val}" placeholder="${f.label}">`;
        }
        wrap.innerHTML = `<label>${f.label}</label>${inner}`;
      }
      fields.appendChild(wrap);
    });
  }
  sel.addEventListener('change', render);
  render();

  // Tombol tukar: pakai output sebagai input berikutnya.
  const swap = document.getElementById('swap');
  swap.addEventListener('click', () => {
    const out = document.getElementById('output');
    if (out) document.getElementById('input').value = out.textContent.trim();
  });

  // ------------------------------------------------------------------
  // Panel FILE: upload -> enkripsi/dekripsi di server -> unduh otomatis.
  // ------------------------------------------------------------------
  const fCipher = document.getElementById('file-cipher');
  const fFields = document.getElementById('file-fields');
  const fDir = document.getElementById('file-direction');
  const fInput = document.getElementById('file-input');
  const fGo = document.getElementById('file-go');
  const fStatus = document.getElementById('file-status');
  const fWarn = document.getElementById('file-warn');

  // Info/peringatan di atas form, berubah sesuai cipher & arah yang dipilih.
  function renderFileWarning(def, direction) {
    // Saat dekripsi, cipher dibaca dari header .dat -> pilihan cipher di atas
    // tidak berpengaruh. Jadi cukup beri tahu, bukan peringatan.
    if (direction === 'decrypt') {
      fWarn.innerHTML =
        '<div class="alert ok"><strong>Info:</strong> Saat dekripsi, cipher &amp; kunci ' +
        'dibaca otomatis dari header berkas <code>.dat</code>. Pilihan cipher di atas ' +
        'diabaikan.</div>';
      return;
    }
    // Enkripsi: cipher 26 huruf hanya memproses A-Z, byte lain (header file,
    // 0x00, gambar, audio) akan HILANG dan file TIDAK BISA dipulihkan.
    if (def.isAlpha) {
      fWarn.innerHTML =
        '<div class="alert danger"><strong>Perhatian:</strong> ' +
        `Cipher <em>${def.name}</em> hanya memproses huruf A–Z. Berkas biner ` +
        '(gambar, audio, video, database) akan <strong>kehilangan semua byte ' +
        'non-huruf</strong> termasuk header berkas, dan <strong>tidak bisa ' +
        'dikembalikan seperti semula</strong>. Untuk berkas, pilih ' +
        '<strong>Extended Vigenere</strong> atau <strong>Super Enkripsi / ' +
        'Transposisi Kolom</strong>.</div>';
      return;
    }
    // Cipher biner: aman untuk berkas apa pun.
    fWarn.innerHTML =
      '<div class="alert ok"><strong>Aman:</strong> ' +
      `Cipher <em>${def.name}</em> memproses seluruh byte (0–255), sehingga ` +
      'berkas apa pun bisa didekripsi kembali utuh.</div>';
  }

  // Render field kunci khusus untuk cipher yang dipilih (dipakai saat enkripsi).
  function renderFileFields() {
    const def = defs.find(d => d.slug === fCipher.value);
    fFields.innerHTML = '';
    (def.keyFields || []).forEach(f => {
      const wrap = document.createElement('div');
      const val = f.defaultValue ?? '';
      if (f.type === 'matrix') {
        wrap.innerHTML = matrixHtml(f, val, 'file', '');
      } else {
        let inner;
        if (f.type === 'select') {
          const opts = (f.options || []).map(
            o => `<option value="${o.value}" ${o.value==val?'selected':''}>${o.label}</option>`).join('');
          inner = `<select name="${f.name}">${opts}</select>`;
        } else {
          inner = `<input type="${f.type === 'number' ? 'number' : 'text'}" name="${f.name}"
                    value="${val}" placeholder="${f.label}">`;
        }
        wrap.innerHTML = `<label>${f.label}</label>${inner}`;
      }
      fFields.appendChild(wrap);
    });
    // Saat dekripsi, kunci dibaca dari header file .dat -> sembunyikan field.
    fFields.style.display = fDir.value === 'decrypt' ? 'none' : '';
    renderFileWarning(def, fDir.value);
  }

  function collectFileParams() {
    const params = {};
    fFields.querySelectorAll('input, select').forEach(el => {
      if (el.name) params[el.name] = el.value;
    });
    return params;
  }

  // Baca File -> byte -> base64 (buang prefix data URL).
  function fileToBase64(file) {
    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = () => {
        const s = String(reader.result);
        resolve(s.slice(s.indexOf(',') + 1));
      };
      reader.onerror = () => reject(new Error('Gagal membaca berkas.'));
      reader.readAsDataURL(file);
    });
  }

  function fileNameFromHeaders(res, fallback) {
    const cd = res.headers.get('Content-Disposition') || '';
    const m = /filename="?([^"]+)"?/.exec(cd);
    return m ? m[1] : fallback;
  }

  fCipher.addEventListener('change', renderFileFields);
  fDir.addEventListener('change', renderFileFields);
  renderFileFields();

  fGo.addEventListener('click', async () => {
    const file = fInput.files && fInput.files[0];
    if (!file) { fStatus.innerHTML = '<span class="err">Pilih berkas dulu.</span>'; return; }

    const direction = fDir.value;
    const isEncrypt = direction === 'encrypt';
    fGo.disabled = true;
    fStatus.textContent = 'Memproses…';

    try {
      const b64 = await fileToBase64(file);
      const url = isEncrypt ? '/api/encrypt-file' : '/api/decrypt-file';
      const payload = isEncrypt
        ? { cipher: fCipher.value, name: file.name, mime: file.type, input: b64,
            params: collectFileParams() }
        : { input: b64 };

      const res = await fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      const ctype = res.headers.get('Content-Type') || '';
      if (!res.ok || ctype.includes('application/json')) {
        const err = await res.json().catch(() => ({ message: 'Terjadi kesalahan.' }));
        throw new Error(err.message || `HTTP ${res.status}`);
      }

      const blob = await res.blob();
      const outName = fileNameFromHeaders(res, isEncrypt ? file.name + '.dat' : file.name);
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = outName;
      document.body.appendChild(a);
      a.click();
      a.remove();
      URL.revokeObjectURL(a.href);

      fStatus.innerHTML = `<span class="ok">Berhasil:</span> ${blob.size} byte → <strong>${outName}</strong> (terunduh).`;
    } catch (e) {
      fStatus.innerHTML = `<span class="err">Gagal:</span> ${e.message}`;
    } finally {
      fGo.disabled = false;
    }
  });
</script>
</body>
</html>
