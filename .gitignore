# ---- Node / JS ----
node_modules/
.pnpm-store/
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# ---- Env & secret ----
.env
.env.local
.env.*.local
!.env.example

# ---- Ruby ----
# CATATAN: pola berisi "/" bersifat anchored ke root .gitignore,
# jadi harus pakai "**/" supaya vendor/bundle di apps/api ikut ter-ignore.
**/vendor/bundle/
**/.bundle/
*.gem
Gemfile.lock.bak

# ---- Test & coverage ----
coverage/
.nyc_output/

# ---- Aturan agen (lokal saja, TIDAK di-commit) ----
# AGENTS.md = instruksi kerja untuk coding agent (OpenCode). Isinya spesifik
# mesin lokal + referensi path absolut, jadi tidak ikut repo publik.
# Di-commit ke git hanya akan membingungkan pembaca repo.
AGENTS.md
**/AGENTS.md

# ---- Editor / OS ----
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~

# ---- Cloudflare / Wrangler ----
.wrangler/
.dev.vars

# ---- Build artifact tugas (jangan pernah di-commit) ----
laporan/*.zip
laporan/*.pdf
# hasil build-laporan.py (gambar base64) — dihasilkan ulang, tidak perlu di-commit
laporan/laporan-uts-kriptografi.html
*.dat

# ---- Log ----
*.log
npm-debug.log*
pnpm-debug.log*
